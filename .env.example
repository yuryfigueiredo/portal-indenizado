# =====================================================================
# CONFIGURAÇÃO DE MODELOS LLM (CrewAI)
# =====================================================================
# Escolha como deseja conectar seus modelos de IA:

# OPÇÃO 1: Provedores em Nuvem (OpenAI, OpenRouter, Groq, Gemini)
# OPENAI_API_KEY=sua_chave_aqui
# OPENROUTER_API_KEY=sua_chave_aqui
# GROQ_API_KEY=sua_chave_aqui

# OPÇÃO 2: 9router / Servidor Local / Fallback OpenAI-compatível
# Se você usa o 9router ou LM Studio rodando localmente (ex: porta 1234):
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_API_KEY=dummy-key-for-local-proxy
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Controle de telemetria do CrewAI
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_OPT_OUT=true
